---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { absoluteUrl, localePath, type Locale } from "../lib/i18n/locale";
import { t } from "../lib/i18n/ui";
import { SITE, gtmId } from "../lib/site";
import { getContent } from "../lib/microcms/client";
import type { Crumb } from "../lib/seo/jsonld";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  enPath?: string | null;
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  jsonLd?: string | null;
  home?: boolean;
  alternate?: boolean;
}

const {
  locale,
  title,
  description,
  path,
  enPath = path,
  noindex = false,
  ogType = "website",
  ogImage = absoluteUrl(SITE.defaultOgPath),
  jsonLd = null,
  home = false,
  alternate = true,
} = Astro.props;

const content = await getContent();
const canonicalPath = localePath(locale, path);
const canonical = absoluteUrl(canonicalPath);
const copy = t(locale);
const gtm = gtmId();
const paired = enPath !== null;
const jaHref = absoluteUrl(localePath("ja", path));
const enHref = paired ? absoluteUrl(localePath("en", enPath ?? path)) : null;
---

<!doctype html>
<html lang={locale} data-motion="high">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="max-image-preview:large" />}
    {paired && !noindex && alternate && (
      <>
        <link rel="alternate" hreflang="ja" href={jaHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="x-default" href={jaHref} />
      </>
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={locale === "ja" ? SITE.legalNameJa : SITE.legalNameEn} />
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {(path === "/trends" || path.startsWith("/trends/category/")) && (
      <link rel="alternate" type="application/rss+xml" title="Trends" href={absoluteUrl("/trends/rss.xml")} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Outfit:wght@500;600&display=swap" media="print" id="fonts" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Outfit:wght@500;600&display=swap" />
    </noscript>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var cores = navigator.hardwareConcurrency || 8;
        var memory = navigator.deviceMemory || 8;
        var save = navigator.connection && navigator.connection.saveData;
        var tier = "high";
        if (reduce) tier = "reduced";
        else if (save || memory <= 2 || cores <= 2) tier = "low";
        else if (memory < 8 || cores < 8) tier = "medium";
        document.documentElement.dataset.motion = tier;
        var fonts = document.getElementById("fonts");
        if (fonts) fonts.media = "all";
      })();
    </script>
    {gtm && (
      <script is:inline define:vars={{ gtm }}>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtm.js?id=" + gtm;
        document.head.appendChild(s);
      </script>
    )}
  </head>
  <body>
    {gtm && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe>
      </noscript>
    )}
    <a class="skip" href="#content">{copy.skip}</a>
    <Header locale={locale} path={path} enPath={enPath} />
    <main id="content" class:list={{ "is-home": home }}>
      <slot />
    </main>
    <Footer locale={locale} settings={content.settings} />
    <script>
      import { bootSite } from "../animations/site";
      bootSite();
    </script>
  </body>
</html>
