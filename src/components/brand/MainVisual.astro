---
import type { Locale } from "../../lib/i18n/locale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sub = locale === "ja" ? "成長に、追い風を。" : "A clear morning, and a following wind.";
const main = {
  calm: "M168 8C118 120 108 250 128 392L168 400C156 260 154 140 168 8Z",
  half: "M168 8C70 118 48 260 96 396L168 404C130 268 146 140 168 8Z",
  full: "M168 8C28 112 4 268 64 398L168 408C112 270 138 140 168 8Z",
};
const jib = {
  calm: "M168 96C206 150 214 250 198 348L174 356C196 250 188 150 168 96Z",
  half: "M168 88C236 146 262 252 228 356L174 364C214 258 196 148 168 88Z",
  full: "M168 78C260 140 312 248 258 362L174 372C228 260 204 146 168 78Z",
};
---

<section class="mv" data-motion="MO-HOME-01" data-mv aria-label="Tailwinds For Your Growth">
  <div class="mv-sky" aria-hidden="true"></div>
  <canvas class="mv-gl" aria-hidden="true"></canvas>
  <noscript>
    <picture>
      <source media="(max-width: 800px)" srcset="/mv/sp-1080.avif" type="image/avif" />
      <source media="(max-width: 800px)" srcset="/mv/sp-1080.webp" type="image/webp" />
      <source type="image/avif" srcset="/mv/pc-1280.avif 1280w, /mv/pc-1920.avif 1920w, /mv/pc-2560.avif 2560w" sizes="100vw" />
      <img class="mv-still" src="/mv/pc-1280.webp" alt="" />
    </picture>
  </noscript>
  <div class="mv-fleet" data-fleet aria-hidden="true">
    <svg class="distant" viewBox="0 0 80 70">
      <path fill="#ffffff" d="M40 4C28 24 22 42 28 56H40C34 38 34 18 40 4Z" />
      <path fill="#fff6e0" fill-opacity="0.9" d="M40 16C52 30 58 44 52 56H40C46 40 44 26 40 16Z" />
      <path fill="#e7f4fb" d="M18 56C32 52 54 52 70 56L64 64C46 68 28 68 14 60Z" />
    </svg>
    <svg class="distant distant-b" viewBox="0 0 80 70">
      <path fill="#ffffff" d="M40 8C30 26 24 42 30 56H40C36 40 36 22 40 8Z" />
      <path fill="#fff4d8" fill-opacity="0.8" d="M40 18C50 32 56 44 50 56H40C46 40 44 28 40 18Z" />
      <path fill="#e3f1f8" d="M20 56C34 52 52 52 66 56L60 63C44 66 30 66 16 60Z" />
    </svg>
  </div>
  <div class="mv-gulls" aria-hidden="true">
    <span class="gull" style="--flap:0.9s;--delay:0s;--count:6">
      <svg viewBox="0 0 30 12"><path d="M1 7c5-5 9-5 14 0M15 7c5-5 9-5 14 0" /></svg>
    </span>
    <span class="gull" style="--flap:1.1s;--delay:0.35s;--count:5">
      <svg viewBox="0 0 30 12"><path d="M1 7c5-5 9-5 14 0M15 7c5-5 9-5 14 0" /></svg>
    </span>
    <span class="gull gull-c" style="--flap:1.3s;--delay:0.7s;--count:4">
      <svg viewBox="0 0 30 12"><path d="M1 7c5-5 9-5 14 0M15 7c5-5 9-5 14 0" /></svg>
    </span>
  </div>
  <div class="mv-boat" data-boat>
    <div class="keel-shadow" aria-hidden="true"></div>
    <svg class="wake-v" viewBox="0 0 100 31.68" aria-hidden="true">
      <defs>
        <filter id="mv-wake-soft" filterUnits="userSpaceOnUse" x="58" y="-2" width="52" height="36">
          <feGaussianBlur stdDeviation="1.35" />
        </filter>
        <filter id="mv-wake-ridge" filterUnits="userSpaceOnUse" x="-6" y="-6" width="112" height="44">
          <feGaussianBlur stdDeviation="0.28" />
        </filter>
        <linearGradient id="mv-wake-fade" x1="100" y1="16" x2="62" y2="16" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.5" />
          <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path fill="url(#mv-wake-fade)" d="M99 15.8C90 12.4 78 11.2 66 13.6C74 15.2 76 16.4 66 18.2C78 20.4 90 19.2 99 15.8Z" />
      <g filter="url(#mv-wake-soft)">
        <ellipse cx="96.4" cy="15.8" rx="9.2" ry="4.2" fill="#fff" opacity="0.82" />
        <ellipse cx="88.6" cy="13.1" rx="6.2" ry="2.6" fill="#fff" opacity="0.55" />
        <ellipse cx="89.4" cy="18.8" rx="5.8" ry="2.45" fill="#fff" opacity="0.5" />
        <ellipse cx="80.2" cy="15.4" rx="5.2" ry="2.9" fill="#fff" opacity="0.36" />
        <ellipse cx="83.4" cy="11.2" rx="3.2" ry="1.6" fill="#fff" opacity="0.4" />
        <ellipse cx="82.2" cy="20.4" rx="3" ry="1.7" fill="#fff" opacity="0.32" />
        <ellipse cx="73.5" cy="13.6" rx="3.6" ry="1.9" fill="#fff" opacity="0.24" />
        <ellipse cx="74.8" cy="18.6" rx="3.1" ry="1.6" fill="#fff" opacity="0.2" />
        <ellipse cx="93.8" cy="11.6" rx="2.4" ry="1.2" fill="#fff" opacity="0.42" />
        <ellipse cx="94.2" cy="20.2" rx="2" ry="1.15" fill="#fff" opacity="0.3" />
      </g>
      <g filter="url(#mv-wake-ridge)" fill="#fff">
        <ellipse cx="85" cy="13.6" rx="2.37" ry="1.38" opacity="0.64" transform="rotate(-62 85 13.6)" />
        <ellipse cx="85" cy="18.1" rx="2.37" ry="1.38" opacity="0.64" transform="rotate(62 85 18.1)" />
        <ellipse cx="76" cy="13.4" rx="2.28" ry="1.33" opacity="0.3" transform="rotate(-24 76 13.4)" />
        <ellipse cx="76" cy="18.2" rx="2.28" ry="1.33" opacity="0.3" transform="rotate(24 76 18.2)" />
        <ellipse cx="67" cy="11" rx="2.2" ry="1.28" opacity="0.52" transform="rotate(-78 67 11)" />
        <ellipse cx="67" cy="20.7" rx="2.2" ry="1.28" opacity="0.52" transform="rotate(78 67 20.7)" />
        <ellipse cx="57" cy="10.9" rx="2.11" ry="1.23" opacity="0.26" transform="rotate(-34 57 10.9)" />
        <ellipse cx="57" cy="20.8" rx="2.11" ry="1.23" opacity="0.26" transform="rotate(34 57 20.8)" />
        <ellipse cx="47" cy="8" rx="2.02" ry="1.19" opacity="0.42" transform="rotate(-58 47 8)" />
        <ellipse cx="47" cy="23.6" rx="2.02" ry="1.19" opacity="0.42" transform="rotate(58 47 23.6)" />
        <ellipse cx="37" cy="8.1" rx="1.93" ry="1.14" opacity="0.2" transform="rotate(-20 37 8.1)" />
        <ellipse cx="37" cy="23.6" rx="1.93" ry="1.14" opacity="0.2" transform="rotate(20 37 23.6)" />
        <ellipse cx="26" cy="5" rx="1.83" ry="1.08" opacity="0.32" transform="rotate(-74 26 5)" />
        <ellipse cx="26" cy="26.7" rx="1.83" ry="1.08" opacity="0.32" transform="rotate(74 26 26.7)" />
        <ellipse cx="15" cy="3.9" rx="1.73" ry="1.02" opacity="0.14" transform="rotate(-44 15 3.9)" />
        <ellipse cx="15" cy="27.8" rx="1.73" ry="1.02" opacity="0.14" transform="rotate(44 15 27.8)" />
        <circle cx="80.4" cy="15.2" r="0.7" opacity="0.26" />
        <circle cx="71.2" cy="16.6" r="0.5" opacity="0.16" />
        <circle cx="62.4" cy="14.4" r="0.55" opacity="0.18" />
        <circle cx="53.6" cy="17.2" r="0.4" opacity="0.12" />
        <circle cx="42.8" cy="15.6" r="0.35" opacity="0.1" />
      </g>
    </svg>
    <svg class="boat-svg" viewBox="0 0 340 460" aria-hidden="true">
      <defs>
        <linearGradient id="sail-camber" x1="0" y1="0.15" x2="1" y2="0">
          <stop offset="0" stop-color="#c5daf0" stop-opacity="0.78" />
          <stop offset="0.32" stop-color="#f7fbfe" stop-opacity="0.94" />
          <stop offset="0.58" stop-color="#ffffff" stop-opacity="0.99" />
          <stop offset="0.82" stop-color="#fff3d4" stop-opacity="0.62" />
          <stop offset="1" stop-color="#ffe4b0" stop-opacity="0.34" />
        </linearGradient>
        <radialGradient id="sail-belly" cx="0.66" cy="0.42" r="0.58">
          <stop offset="0" stop-color="#fff6e4" stop-opacity="0.45" />
          <stop offset="0.55" stop-color="#ffffff" stop-opacity="0.12" />
          <stop offset="1" stop-color="#d5e6f4" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="hull-form" x1="0.15" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="0.42" stop-color="#f3f8fb" />
          <stop offset="0.72" stop-color="#d7e5ef" />
          <stop offset="1" stop-color="#c5d5e2" />
        </linearGradient>
        <linearGradient id="mast-shade" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#152028" />
          <stop offset="0.4" stop-color="#2a3d4a" />
          <stop offset="0.74" stop-color="#5c7382" />
          <stop offset="1" stop-color="#c5d4de" />
        </linearGradient>
        <filter id="mv-foam" filterUnits="userSpaceOnUse" x="200" y="360" width="200" height="140">
          <feGaussianBlur stdDeviation="2.8" />
        </filter>
        <filter id="mv-spray" filterUnits="userSpaceOnUse" x="300" y="330" width="100" height="110">
          <feGaussianBlur stdDeviation="0.45" />
        </filter>
        <linearGradient id="hull-sheer" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#9bb4c6" stop-opacity="0.12" />
          <stop offset="0.55" stop-color="#ffffff" stop-opacity="0.16" />
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.8" />
        </linearGradient>
        <filter id="mv-refl-blur" filterUnits="userSpaceOnUse" x="-60" y="340" width="500" height="300">
          <feGaussianBlur stdDeviation="6" />
        </filter>
        <filter id="mv-edge-blur" x="-8%" y="-8%" width="116%" height="116%">
          <feGaussianBlur stdDeviation="2" />
        </filter>
        <mask id="mv-wet" maskUnits="userSpaceOnUse" x="-20" y="0" width="400" height="480">
          <rect x="-20" y="0" width="400" height="480" fill="#fff" />
          <path filter="url(#mv-edge-blur)" fill="#000" d="M-20 430C70 468 250 462 360 416L360 490L-20 490Z" />
        </mask>
      </defs>
      <g class="boat-reflect">
        <g opacity="0.22" filter="url(#mv-refl-blur)" transform="translate(0 432) scale(1 -0.4) translate(0 -432)">
          <use href="#mv-boat-draw" />
        </g>
      </g>
      <g id="mv-boat-draw">
        <g mask="url(#mv-wet)">
          <path class="hull" fill="url(#hull-form)" d="M46 404C92 388 140 396 170 392C236 384 300 364 334 348L320 428C246 456 108 462 40 438Z" />
          <path fill="url(#hull-sheer)" d="M46 404C92 388 140 396 170 392C236 384 300 364 334 348L320 428C246 456 108 462 40 438Z" />
          <path class="stripe" d="M52 400C98 386 146 394 172 390C234 382 296 364 328 350" />
        </g>
        <path class="waterline" d="M44 432C108 456 248 450 318 424" />
        <path class="waterline-hi" d="M52 424C112 446 244 440 312 416" />
        <g class="bow-wave" filter="url(#mv-foam)">
          <path fill="#fff" opacity="0.7" d="M268 448C292 458 318 444 336 430C352 418 366 416 374 428C368 446 348 462 324 468C296 474 274 462 262 452C258 448 262 446 268 448Z" />
          <path fill="#fff" opacity="0.92" d="M312 436C330 420 352 416 368 426C362 440 342 452 322 450C310 446 306 440 312 436Z" />
          <path fill="#fff" opacity="0.55" d="M338 418C352 408 366 410 372 420C364 428 350 432 338 428C332 424 332 420 338 418Z" />
        </g>
        <g data-leech>
          <path data-sail="main" fill="url(#sail-camber)" d={main.calm} data-half={main.half} data-full={main.full} />
          <path data-sail="jib" fill="url(#sail-camber)" d={jib.calm} data-half={jib.half} data-full={jib.full} />
          <path class="sail-shade" fill="url(#sail-belly)" d={main.calm} data-half={main.half} data-full={main.full} />
          <path class="sail-shade" fill="url(#sail-belly)" d={jib.calm} data-half={jib.half} data-full={jib.full} />
        </g>
        <path class="mast-bar" fill="url(#mast-shade)" d="M162.2 430L177.8 430L172.2 8L167.8 8Z" />
        <path class="mast-hi" fill="#ffffff" opacity="0.78" d="M173.2 420L175.8 420L171.7 16L170.2 16Z" />
        <g data-boom>
          <path class="boom-bar" fill="url(#mast-shade)" d="M166.2 381.2L169.2 387.6L141.6 392.6L139.2 386.4Z" />
          <path class="boom-hi" fill="#ffffff" opacity="0.62" d="M166.6 382.2L167.8 384.4L140.6 388.2L139.6 386.2Z" />
        </g>
        <g class="spray" data-spray filter="url(#mv-spray)" fill="#fff" stroke="none">
          <circle cx="336" cy="402" r="2.2" opacity="0.62" />
          <circle cx="344" cy="388" r="1.45" opacity="0.4" />
          <circle cx="340" cy="376" r="0.85" opacity="0.24" />
          <circle cx="354" cy="394" r="1.05" opacity="0.28" />
          <circle cx="350" cy="368" r="0.5" opacity="0.12" />
          <circle cx="362" cy="386" r="0.62" opacity="0.14" />
          <circle cx="348" cy="408" r="0.9" opacity="0.2" />
          <circle cx="332" cy="390" r="1.15" opacity="0.34" />
          <circle cx="358" cy="374" r="0.38" opacity="0.08" />
        </g>
      </g>
    </svg>
  </div>
  <div class="mv-wind" aria-hidden="true">
    <span class="wind-trail" style="--y:12%;--x:62%"><i style="--w:16vw;--rot:-14deg"></i></span>
    <span class="wind-trail is-hot" style="--y:20%;--x:70%"><i style="--w:13vw;--rot:-18deg"></i></span>
    <span class="wind-trail" style="--y:28%;--x:66%"><i style="--w:15vw;--rot:-11deg"></i></span>
  </div>
  <div class="mv-copy" data-copy>
    <h1 class="mv-brand" lang="en">
      <span class="mv-line">Tailwinds</span>
      <span class="mv-line mv-rest"><span class="mv-for">For Your</span> <span class="mv-growth">Grow<span class="k-wt">t</span>h</span></span>
    </h1>
    <p class="mv-sub mv-ja">{sub}</p>
  </div>
  <a class="mv-scroll" href="#values"><span>SCROLL</span><i aria-hidden="true"></i></a>
  <div class="mv-divider" data-divider data-motion="MO-HOME-03" aria-hidden="true"></div>
  <script>
    import { bootMv } from "../../animations/mv";
    const root = document.querySelector<HTMLElement>("[data-mv]");
    if (root) requestAnimationFrame(() => requestAnimationFrame(() => { void bootMv(root); }));
  </script>
</section>
