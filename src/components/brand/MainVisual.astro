---
import type { Locale } from "../../lib/i18n/locale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sub = locale === "ja" ? "成長に、追い風を。" : "A clear morning, and a following wind.";
const main = {
  calm: "M168 8C118 120 108 250 128 392L168 400C156 260 154 140 168 8Z",
  half: "M168 8C70 118 48 260 96 396L168 404C130 268 146 140 168 8Z",
  full: "M168 8C28 112 4 268 64 398L168 408C112 270 138 140 168 8Z",
};
const jib = {
  calm: "M168 96C206 150 214 250 198 348L174 356C196 250 188 150 168 96Z",
