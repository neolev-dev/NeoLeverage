---
import Logo from "../brand/Logo.astro";
import { localePath, otherLocale, type Locale } from "../../lib/i18n/locale";
import { t } from "../../lib/i18n/ui";

interface Props {
  locale: Locale;
  path: string;
  enPath?: string | null;
}

const { locale, path, enPath = path } = Astro.props;
const copy = t(locale);
const alt = otherLocale(locale);
const altHref = enPath === null ? localePath(alt, "/") : localePath(alt, enPath ?? path);
const items = [
  { href: localePath(locale, "/services"), label: copy.navServices },
  { href: localePath(locale, "/we-are"), label: copy.navWeAre },
  { href: localePath(locale, "/trends"), label: copy.navTrends },
  { href: localePath(locale, "/notice"), label: copy.navNotice },
];
---

<header class="site-header" data-header>
  <div class="nav-pill">
    <a class="logo-link" href={localePath(locale, "/")} aria-label="NeoLeverage">
      <Logo id="header-logo" tone="on-light" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {items.map((item) => (
        <a href={item.href} aria-current={Astro.url.pathname.replace(/\/$/, "") === item.href.replace(/\/$/, "") ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="lang-switch" aria-label={copy.language}>
      <a href={locale === "ja" ? localePath("ja", path) : altHref} hrefLang="ja" aria-current={locale === "ja" ? "true" : undefined}>JP</a>
      <span aria-hidden="true">/</span>
      <a href={locale === "en" ? localePath("en", path) : altHref} hrefLang="en" aria-current={locale === "en" ? "true" : undefined}>EN</a>
    </div>
    <a class="btn btn-accent btn-header" href={localePath(locale, "/contact")}>{copy.consult}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <span class="sr">{copy.menu}</span>
      <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
  </div>
</header>
<div class="overlay" id="site-menu" hidden data-menu>
  <button class="overlay-close" type="button" data-menu-close>{copy.close}</button>
  <nav>
    {items.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={localePath(locale, "/contact")}>{copy.consult}</a>
    <a href={altHref}>{locale === "ja" ? "EN" : "JP"}</a>
  </nav>
</div>

<style>
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .on-dark { color: #fff; }
</style>
