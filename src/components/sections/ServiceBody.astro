---
import { localePath, type Locale } from "../../lib/i18n/locale";
import type { UI } from "../../lib/i18n/ui";
import type { Faq, Service } from "../../lib/microcms/types";

interface Props {
  service: Service;
  locale: Locale;
  copy: UI;
  related: Service[];
  faqs: Faq[];
  quote: string;
  areaName: string;
}

const { service, locale, copy, related, faqs, quote, areaName } = Astro.props;
const ja = locale === "ja";
---

<div class="service-hero">
  <div>
    <slot name="crumbs" />
    <p class="kicker" lang="en">{areaName}</p>
    <h1>{ja ? service.name_ja : service.name_en}</h1>
    <p class="lead">{ja ? service.catch_ja : service.catch_en}</p>
    <p>{ja ? service.summary_ja : service.summary_en}</p>
    <div class="actions">
      <a class="btn btn-accent" href={`${localePath(locale, "/contact")}?topic=${service.slug === "photo-sns-video" ? "photo-sns-video" : service.slug === "ai-automation" ? "ai-automation" : service.area === "marketing" ? "marketing" : "production"}`}>{copy.askService}</a>
      <a class="btn btn-dark" href={localePath(locale, "/services")}>{copy.seeServices}</a>
    </div>
  </div>
  <div class:list={["figure", service.slug === "photo-sns-video" ? "film" : ""]}>
    {service.slug === "photo-sns-video" ? (
      <video src="/mv/film.mp4" muted playsinline preload="metadata" width="720" height="1280" data-film></video>
    ) : null}
    <span>{ja ? "イメージ（生成AI）" : "Image (generated)"}</span>
  </div>
</div>
{service.slug === "photo-sns-video" && (
  <div class="figure band" data-parallax>
    <span>{ja ? "イメージ（生成AI）" : "Image (generated)"}</span>
  </div>
)}
{service.prototype_copy && (
  <p class="placeholder-note" data-placeholder="true"><b>{copy.placeholder}</b>{ja ? copy.servicePrototype : copy.enOnlyBanner}</p>
)}

<section class="section">
  <div class="section-head">
    <p class="en-label" lang="en">Tailwind</p>
    <h2>{ja ? "このサービスの追い風" : "The tailwind in this service"}</h2>
  </div>
  <p class="statement">{ja ? service.tailwind_benefit_ja : service.tailwind_benefit_en}</p>
</section>
<section class="section pair">
  <div>
    <h2>{copy.audience}</h2>
    <ul class="plain">{(ja ? service.audience_ja : service.audience_en).map((item) => <li>{item}</li>)}</ul>
  </div>
  <div>
    <h2>{copy.problems}</h2>
    <ul class="plain">{(ja ? service.problems_ja : service.problems_en).map((item) => <li>{item}</li>)}</ul>
  </div>
</section>
<section>
  <h2>{copy.solution}</h2>
  <p>{ja ? service.solution_ja : service.solution_en}</p>
</section>
<section class="section">
  <div class="section-head">
    <h2>{copy.deliverables}</h2>
    <p class="lead">{ja ? "例" : "Examples"} — {copy.scopeNote}</p>
  </div>
  <div class="rows">
    {(ja ? service.deliverables_ja : service.deliverables_en).map((item, index) => (
      <div class="row">
        <span class="num">{String(index + 1).padStart(2, "0")}</span>
        <span>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
        </span>
      </div>
    ))}
  </div>
</section>
<section class="section">
  <div class="section-head">
    <h2>{copy.process}</h2>
    <p>{ja ? service.timeline_note_ja : service.timeline_note_en}</p>
  </div>
  <ol class="steps">
    {(ja ? service.process_ja : service.process_en).map((step, index) => (
      <li>
        <span class="num">{String(index + 1).padStart(2, "0")}</span>
        <strong>{step.name}</strong>
        <span class="meta">{copy.timelineLabel}</span>
        <p>{step.description}</p>
      </li>
    ))}
  </ol>
</section>
{related.length > 0 && (
  <section class="section">
    <h2>{copy.related}</h2>
    <ul>
      {related.map((item) => <li><a href={localePath(locale, `/services/${item.slug}`)}>{ja ? item.name_ja : item.name_en}</a></li>)}
    </ul>
  </section>
)}
<section class="section">
  <h2>{ja ? "料金について" : "Fees"}</h2>
  <p>{quote}</p>
</section>
{faqs.length > 0 && (
  <section class="section">
    <div class="section-head">
      <p class="en-label" lang="en">FAQ</p>
      <h2>{copy.faq}</h2>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq">
          <summary>{ja ? faq.question_ja : faq.question_en}</summary>
          <p>{ja ? faq.answer_ja : faq.answer_en}</p>
        </details>
      ))}
    </div>
  </section>
)}
<section class="cta-band">
  <div>
    <h2>{copy.ctaLines.map((line) => <span>{line}</span>)}</h2>
    <p>{copy.ctaBody}</p>
  </div>
  <a class="btn btn-accent" href={`${localePath(locale, "/contact")}?topic=${service.slug === "photo-sns-video" ? "photo-sns-video" : service.slug === "ai-automation" ? "ai-automation" : service.area === "marketing" ? "marketing" : "production"}`}>{copy.consult}</a>
</section>
