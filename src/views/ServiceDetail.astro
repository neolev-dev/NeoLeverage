---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/layout/Breadcrumb.astro";
import AreaBody from "../components/sections/AreaBody.astro";
import ServiceBody from "../components/sections/ServiceBody.astro";
import { getContent, isArea } from "../lib/microcms/client";
import { absoluteUrl, localePath, type Locale } from "../lib/i18n/locale";
import { t } from "../lib/i18n/ui";
import { breadcrumbNode, faqNode, graph, organizationGraph, pageNode, serviceNode } from "../lib/seo/jsonld";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const content = await getContent();
const copy = t(locale);
const found = content.services.find((item) => item.slug === slug) ?? content.areas.find((item) => item.slug === slug);
if (!found) throw new Error(`Missing service ${slug}`);
const entry = found;
const areaEntry = isArea(entry) ? entry : content.areas.find((item) => item.slug === entry.area);
const description = locale === "ja" ? entry.seo_ja.seo_description : entry.seo_en.seo_description;
const label = isArea(entry)
  ? entry.name_ja
  : locale === "ja"
    ? entry.seo_ja.breadcrumb_label || entry.name_ja
    : entry.seo_en.breadcrumb_label || entry.name_en;
const title = `${label}${locale === "ja" ? "｜NeoLeverage株式会社" : " | NeoLeverage Inc."}`;
const path = `/services/${slug}`;
const canonical = absoluteUrl(localePath(locale, path));
const crumbs = [
  { name: copy.home, href: localePath(locale, "/") },
  { name: copy.services, href: localePath(locale, "/services") },
  { name: label, href: localePath(locale, path) },
];
const faqs = isArea(entry) ? [] : content.faqs.filter((faq) => faq.services.includes(entry.slug));
const nodes = [
  ...organizationGraph(content.settings, locale),
  pageNode({ canonical, locale, name: title, description, breadcrumb: true }),
  breadcrumbNode(canonical, crumbs),
];
if (!isArea(entry)) nodes.push(serviceNode(entry, locale, canonical));
if (faqs.length) nodes.push(faqNode(canonical, faqs, locale));
const jsonLd = graph(nodes);
const related = !isArea(entry) ? content.services.filter((item) => entry.related_slugs.includes(item.slug)) : [];
const children = isArea(entry) ? content.services.filter((item) => item.area === entry.slug) : [];
---

<BaseLayout locale={locale} title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="page">
    <Breadcrumb items={crumbs} />
    {isArea(entry) ? (
      <AreaBody area={entry} locale={locale} copy={copy} services={children} />
    ) : (
      <ServiceBody service={entry} locale={locale} copy={copy} related={related} faqs={faqs} quote={locale === "ja" ? content.settings.quote_policy_ja : content.settings.quote_policy_en} areaName={areaEntry?.name_ja ?? ""} />
    )}
  </div>
</BaseLayout>
