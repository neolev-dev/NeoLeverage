---
import BaseLayout from "../layouts/BaseLayout.astro";
import { type Locale } from "../lib/i18n/locale";
import { t } from "../lib/i18n/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = t(locale);
const ja = locale === "ja";
const title = ja ? "会社紹介｜NeoLeverage株式会社" : "We Are | NeoLeverage Inc.";
const description = copy.ceoPage;
---

<BaseLayout locale={locale} title={title} description={description} path="/we-are/ceo" noindex jsonLd={null}>
  <div class="page prose">
    <h1>{ja ? "代表者について" : "Representative"}</h1>
    <p>{copy.ceoPage}</p>
  </div>
</BaseLayout>
