# Copy to .env for local builds. Never commit real secrets.
# The site builds with mock content when microCMS variables are empty.

# microCMS (build time, server only — not exposed to the browser)
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Article image origin. Prototype default is the public R2 host.
# Swap to media.neolev.jp when that hostname is approved and live.
MEDIA_HOST=pub-dbe0635cce4240dda8b7b3874f631e3f.r2.dev

# Google Tag Manager. Leave empty to omit the tag (and the DMP it loads).
# Production value used on the current site: GTM-N4ZPT9WH
PUBLIC_GTM_CONTAINER_ID=

# Cloudflare Turnstile. Both keys are required for the widget to render and verify.
# Site key is public. Secret key is read only by Pages Functions.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend. When RESEND_API_KEY is empty, /api/contact validates input and returns a mocked success.
# CONTACT_TO is the inbox. It is never rendered on the site.
RESEND_API_KEY=
CONTACT_TO=contract@neolev.jp
CONTACT_FROM=
